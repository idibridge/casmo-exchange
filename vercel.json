{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/individuals",
      "destination": "/"
    },
    {
      "source": "/business",
      "destination": "/"
    },
    {
      "source": "/how",
      "destination": "/"
    },
    {
      "source": "/contacts",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/ved",
      "destination": "/"
    },
    {
      "source": "/en/individuals",
      "destination": "/en"
    },
    {
      "source": "/en/business",
      "destination": "/en"
    },
    {
      "source": "/en/how",
      "destination": "/en"
    },
    {
      "source": "/en/contacts",
      "destination": "/en"
    },
    {
      "source": "/en/privacy",
      "destination": "/en"
    },
    {
      "source": "/en/ved",
      "destination": "/en"
    },
    {
      "source": "/es/individuals",
      "destination": "/es"
    },
    {
      "source": "/es/business",
      "destination": "/es"
    },
    {
      "source": "/es/how",
      "destination": "/es"
    },
    {
      "source": "/es/contacts",
      "destination": "/es"
    },
    {
      "source": "/es/privacy",
      "destination": "/es"
    },
    {
      "source": "/es/ved",
      "destination": "/es"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?:en/|es/)?(?:business|individuals|ved|how|contacts|privacy)|en|es)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/contacts",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/en/contacts",
      "permanent": true
    },
    {
      "source": "/es/about",
      "destination": "/es/contacts",
      "permanent": true
    },
    {
      "source": "/otc",
      "destination": "/contacts",
      "permanent": true
    },
    {
      "source": "/en/otc",
      "destination": "/en/contacts",
      "permanent": true
    },
    {
      "source": "/es/otc",
      "destination": "/es/contacts",
      "permanent": true
    }
  ]
}